{
  "name": "nexus-omni-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs",
    "verify:runtime": "tsx scripts/verify_runtime_path.ts",
    "verify:fold": "tsx scripts/verify_latent_fold.ts",
    "verify:forge": "tsx scripts/verify_nexus_forge.ts",
    "verify:legend": "tsx scripts/verify_legend_engine.ts",
    "verify:ops": "tsx scripts/verify_nexus_ops.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
